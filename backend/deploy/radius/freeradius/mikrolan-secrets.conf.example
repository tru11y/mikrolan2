# MikroLan — secret partagé FreeRADIUS <-> API NestJS.
#
# MODÈLE. Le vrai fichier /etc/freeradius/3.0/mikrolan-secrets.conf :
#   - N'EST PAS committé (voir .gitignore : backend/deploy/radius/freeradius/mikrolan-secrets.conf).
#   - Est posé à la main, 0640 root:freerad (le démon doit le lire, pas plus ;
#     l'utilisateur est `freerad` sur Debian/Ubuntu, `radiusd` sur RHEL).
#   - Contient le MÊME secret que RADIUS_INTERNAL_TOKEN de backend/.env.
#
# $INCLUDE par mods-available/rest ; référencé via ${..radius_internal_token}.
# Rotation : changer ici ET dans backend/.env, puis `systemctl reload freeradius`
# et redémarrer mikrolan-api. Les deux valeurs doivent toujours coïncider.
#
radius_internal_token = "REMPLACER_PAR_LE_MEME_SECRET_QUE_RADIUS_INTERNAL_TOKEN"
