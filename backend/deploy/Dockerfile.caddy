# Caddy officiel ne bundle pas le plugin route53 — build custom via xcaddy.
# Défi ACME en DNS-01 (pas HTTP-01) : Caddy n'a besoin que du port 443,
# jamais du port 80 — donc aucun contact avec le nginx v1 (default_server:80).
FROM caddy:2-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/route53

FROM caddy:2
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
