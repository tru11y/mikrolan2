[Unit]
Description=MikroLan v2 API (NestJS)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mikrolan/backend
EnvironmentFile=/opt/mikrolan/backend/.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
# Unprivileged user + CAP_NET_ADMIN for `wg set` + `iptables` (DNAT port forwarding).
# Prérequis one-shot sur le VPS avant premier démarrage avec cette unit :
#   useradd --system --no-create-home --shell /usr/sbin/nologin mikrolan
#   chown -R mikrolan:mikrolan /opt/mikrolan/backend
User=mikrolan
Group=mikrolan
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mikrolan/backend

[Install]
WantedBy=multi-user.target
