# /etc/wireguard/wg-mgmt.conf  — MikroLan v2 management tunnel (server side)
# Distinct from v1 wg0 (10.66.66/51820) and from the Python rehost reservation.
#   Subnet : 10.20.0.0/24  (server = 10.20.0.1, routers = 10.20.0.2+)
#   Port   : 51822/udp
# Generate keys:  wg genkey | tee server.key | wg pubkey > server.pub
# Put server.pub into WG_SERVER_PUBLIC_KEY of the API .env.

[Interface]
Address = 10.20.0.1/24
ListenPort = 51822
PrivateKey = <SERVER_PRIVATE_KEY>
# Firewall rules persisted via the wg-quick lifecycle (interface enabled at boot).
# NOTE: this VPS has INPUT policy DROP and NO `-i lo -j ACCEPT` rule — loopback is
# dropped, so the host-network API can't reach host-bound Postgres/Redis without
# the first line below. (v1 is unaffected: it exposes via docker-proxy on 0.0.0.0.)
PostUp = iptables -w 5 -C INPUT -i lo -j ACCEPT 2>/dev/null || iptables -w 5 -I INPUT -i lo -j ACCEPT
# Les paquets déchiffrés revenant par wg-mgmt (réponses des routeurs au backend)
# sont acceptés UNIQUEMENT s'ils font partie d'une connexion initiée par le VPS.
# Un routeur client (non fiable) ne peut donc ouvrir aucune connexion vers les
# services du VPS (SSH, nginx v1, API…).
PostUp = iptables -w 5 -C INPUT -i wg-mgmt -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || iptables -w 5 -I INPUT -i wg-mgmt -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
PostDown = iptables -w 5 -D INPUT -i wg-mgmt -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || true
PostUp = iptables -w 5 -A INPUT -i wg-mgmt -j DROP
PostDown = iptables -w 5 -D INPUT -i wg-mgmt -j DROP 2>/dev/null || true
# Isolation inter-tenants : aucun routeur ne peut joindre un autre routeur via le VPS.
PostUp = iptables -w 5 -I FORWARD -i wg-mgmt -o wg-mgmt -j DROP
PostDown = iptables -w 5 -D FORWARD -i wg-mgmt -o wg-mgmt -j DROP 2>/dev/null || true
PostUp = iptables -w 5 -C INPUT -p udp --dport 51822 -j ACCEPT 2>/dev/null || iptables -w 5 -A INPUT -p udp --dport 51822 -j ACCEPT
# L'API écoute sur 127.0.0.1:3002 (Caddy en frontal) : aucune règle INPUT 3002.
# Chaque peer devrait en plus avoir une PresharedKey (wg set … preshared-key).
# Peers are added dynamically by the API (`wg set wg-mgmt peer ...`); do not
# list them here (they would be lost on `wg-quick down`).

# Enable:  systemctl enable --now wg-quick@wg-mgmt
