[Unit]
Description=MikroLan — sauvegarde différentielle pgBackRest (diff) de la stanza mikrolan
Documentation=file:/opt/mikrolan2/backend/deploy/backup/pitr/README.md
Requires=docker.service
After=docker.service
# Alerting sur échec : journalise l'incident (cf. pgbackrest-backup-alert@.service).
# À brancher sur l'astreinte réelle (mail/webhook) — voir README section alerting.
OnFailure=pgbackrest-backup-alert@%n.service

[Service]
Type=oneshot
# Diff depuis la dernière full : raccourcit le RTO (moins de WAL à rejouer).
# root pour piloter docker ; le binaire s'exécute en `postgres` dans le conteneur.
User=root
ExecStart=/usr/bin/docker exec -u postgres mikrolan2-pg pgbackrest --stanza=mikrolan --type=diff backup
Nice=10
IOSchedulingClass=idle
