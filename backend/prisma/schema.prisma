// MikroLan — commercial multi-tenant SaaS.
// Isolation: row-level tenant_id + global TenantGuard + Prisma tenant middleware.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────
enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  SUPER_ADMIN // plateforme, hors tenant (bypass TenantGuard)
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  FREE // gestion locale seule
  PRO // remote activé
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum RouterHealth {
  UNKNOWN
  ONLINE
  OFFLINE
  ERROR
}

enum ManagementMode {
  LOCAL
  REMOTE
}

enum RemotePeerStatus {
  PENDING
  ACTIVE
  REVOKED
  ERROR
}

enum PaymentProvider {
  MANUAL // activation abonnement validée manuellement (pas de paiement auto)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  PROVISION
  REVOKE
  SUBSCRIBE
}

// ─── HOTSPOT / VOUCHERS (P7 — boucle vendable) ───────────
enum PlanStatus {
  ACTIVE
  ARCHIVED
}

// Comptage de la validité : RADIO_PAUSE = temps connecté seulement (limit-uptime,
// natif) ; ELAPSED = temps écoulé depuis la 1re connexion (fenêtre calendaire).
enum PlanExpiration {
  ELAPSED
  RADIO_PAUSE
}

enum VoucherStatus {
  GENERATED // créé, poussé sur le routeur, jamais utilisé
  ACTIVE // première connexion faite, session en cours
  USED // temps/data épuisé
  EXPIRED // date de validité dépassée
  REVOKED // annulé par l'opérateur
}

enum VoucherBatchStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum SessionStatus {
  ACTIVE
  TERMINATED
}

enum GenerationType {
  MANUAL // généré par un vendeur/opérateur
  AUTO // acheté par le client (portail Mobile Money, P9)
}

// ─── TENANT (racine d'isolation) ─────────────────────────
model Tenant {
  id             String         @id @default(uuid())
  name           String
  slug           String         @unique
  status         TenantStatus   @default(ACTIVE)
  users          User[]
  routers        Router[]
  subscription   Subscription?
  invoices       Invoice[]
  auditLogs      AuditLog[]
  plans          Plan[]
  voucherBatches VoucherBatch[]
  vouchers       Voucher[]
  sessions       Session[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
}

// ─── USER (email global unique → résout le tenant au login) ─
model User {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  email         String         @unique
  passwordHash  String // Argon2id
  role          UserRole       @default(MEMBER)
  status        UserStatus     @default(ACTIVE)
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
}

// ─── REFRESH TOKEN (family rotation) ─────────────────────
model RefreshToken {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  tokenHash    String   @unique
  family       String
  revoked      Boolean  @default(false)
  replacedById String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([family])
}

// ─── ROUTER (unique par tenant) ──────────────────────────
model Router {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  identity       String
  alias          String?
  model          String?
  localAddress   String? // IP:port LAN (mode local)
  credEncrypted  String? // creds RouterOS AES-256-GCM (remote seulement)
  mode           ManagementMode @default(LOCAL)
  health         RouterHealth   @default(UNKNOWN)
  lastHeartbeat  DateTime?
  remotePeer     RemotePeer?
  plans          Plan[]
  voucherBatches VoucherBatch[]
  vouchers       Voucher[]
  sessions       Session[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@unique([tenantId, identity])
  @@index([tenantId])
  @@index([tenantId, health])
}

// ─── REMOTE PEER (WG, provisionné si abonnement PRO actif) ─
model RemotePeer {
  id              String           @id @default(uuid())
  routerId        String           @unique
  router          Router           @relation(fields: [routerId], references: [id])
  tenantId        String
  wgPublicKey     String
  wgIp            String           @unique
  allocatedPort   Int              @unique
  serverPublicKey String
  endpoint        String
  status          RemotePeerStatus @default(PENDING)
  provisionedAt   DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([tenantId])
}

// ─── SUBSCRIPTION (1 par tenant) ─────────────────────────
model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

// ─── INVOICE / PAIEMENT (idempotent) ─────────────────────
model Invoice {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  amount         Int // XOF (entier)
  currency       String          @default("XOF")
  provider       PaymentProvider @default(MANUAL)
  providerRef    String?
  idempotencyKey String          @unique
  status         PaymentStatus   @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime        @default(now())

  @@index([tenantId])
}

// ─── AUDIT LOG (append-only) ─────────────────────────────
model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
}

// ─── PLAN (forfait WiFi = user-profile RouterOS) ─────────
model Plan {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  routerId        String?
  router          Router?        @relation(fields: [routerId], references: [id])
  name            String
  slug            String
  description     String?
  durationMinutes Int // validité de session (limit-uptime)
  priceXof        Int
  downloadKbps    Int? // rate-limit descendant (null = illimité)
  uploadKbps      Int? // rate-limit montant
  dataLimitMb     Int? // quota (limit-bytes-total), null = illimité
  sharedUsers     Int            @default(1) // logins simultanés (RouterOS shared-users)
  expirationMode  PlanExpiration @default(RADIO_PAUSE) // Temps écoulé vs Pause radio
  userProfile     String         @default("default") // nom du profile RouterOS
  status          PlanStatus     @default(ACTIVE)
  displayOrder    Int            @default(0)
  voucherBatches  VoucherBatch[]
  vouchers        Voucher[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, routerId, slug])
  @@index([tenantId])
  @@index([routerId])
  @@index([tenantId, status])
}

// ─── VOUCHER BATCH (lot de codes généré en une fois) ─────
model VoucherBatch {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  planId      String
  plan        Plan               @relation(fields: [planId], references: [id])
  routerId    String
  router      Router             @relation(fields: [routerId], references: [id])
  quantity    Int
  generated   Int                @default(0)
  status      VoucherBatchStatus @default(PENDING)
  createdById String?
  vouchers    Voucher[]
  createdAt   DateTime           @default(now())
  completedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// ─── VOUCHER (code hotspot = user RouterOS) ──────────────
model Voucher {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  planId         String
  plan           Plan           @relation(fields: [planId], references: [id])
  routerId       String
  router         Router         @relation(fields: [routerId], references: [id])
  batchId        String?
  batch          VoucherBatch?  @relation(fields: [batchId], references: [id])
  code           String // identifiant hotspot (username)
  password       String // credential hotspot imprimé sur le ticket
  status         VoucherStatus  @default(GENERATED)
  generationType GenerationType @default(MANUAL)
  mikrotikId     String? // .id du /ip/hotspot/user sur le routeur
  expiresAt      DateTime?
  usedAt         DateTime?
  revokedAt      DateTime?
  createdById    String?
  session        Session?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([routerId])
  @@index([batchId])
}

// ─── SESSION (connexion active reflétée depuis le routeur) ─
model Session {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  voucherId    String        @unique
  voucher      Voucher       @relation(fields: [voucherId], references: [id])
  routerId     String
  router       Router        @relation(fields: [routerId], references: [id])
  mikrotikId   String? // .id du /ip/hotspot/active
  macAddress   String?
  ipAddress    String?
  status       SessionStatus @default(ACTIVE)
  bytesIn      BigInt        @default(0)
  bytesOut     BigInt        @default(0)
  startedAt    DateTime      @default(now())
  lastSeenAt   DateTime?
  terminatedAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([routerId])
}
