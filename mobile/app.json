{
  "expo": {
    "name": "MikroLan",
    "slug": "mikrolan",
    "scheme": "mikrolan",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.mikrolan.app",
      "usesCleartextTraffic": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikrolan.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
