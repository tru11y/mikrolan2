{
  "expo": {
    "name": "MikroLan",
    "slug": "mikrolan",
    "scheme": "mikrolan",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/logo.png",
    "backgroundColor": "#0B0B12",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B12"
    },
    "android": {
      "package": "com.mikrolan.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 33,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0B0B12"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikrolan.app",
      "usesAppleSignIn": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#0B0B12"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "disableAutoUpload": true
        }
      ]
    ],
    "extra": {
      "googleWebClientId": "117981881273-afojeenne76bdus8mlhhmj7m9laocb53.apps.googleusercontent.com",
      "googleAndroidClientId": "117981881273-q17fhovklrn161u6g2lj647c02bjs2da.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "73cb9269-d193-4456-860f-982803af4a06"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "owner": "tru1y"
  }
}
